# Puerto del servidor Express
PORT=4000

# Secreto para firmar los tokens de sesión (cámbialo en producción)
JWT_SECRET=cambia-este-secreto-en-produccion
# Tiempo de vida del token de sesión
JWT_EXPIRES_IN=2h

# Orígenes permitidos por CORS (separados por coma). "|" habilita cualquiera en desarrollo.
CORS_ORIGIN=http://localhost:5173

# Puerto del frontend en desarrollo (Vite)
FRONTEND_PORT=5173

# Milisegundos que tarda el simulador cuando se pide una respuesta lenta (modo timeout)
SHELLPAY_TIMEOUT_DELAY_MS=15000
